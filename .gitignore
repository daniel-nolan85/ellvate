# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/
# Trailing-slash patterns only match real directories -- a worktree whose
# node_modules is a symlink (e.g. shared from the main checkout to save a
# reinstall) falls through the pattern above and shows up as untracked.
node_modules

# Local-only demo seed route for promo/screenshot capture -- never meant to
# ship; deleted before any branch using it is committed. Ignored outright so
# it can sit in a worktree without ever showing as untracked.
app/api/dev-seed+api.ts

# Real photos supplied for the same promo/screenshot capture (served locally
# as demo-seed avatar images) -- personal images of real people, never meant
# to enter a public repo's history.
/public/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env.*
!.env.example
!.env.production.local.example

# typescript
*.tsbuildinfo

# Next.js (admin dashboard)
/admin/.next/
/admin/next-env.d.ts

# local dev-preview tooling
.claude/launch.json

app-example

# generated native folders
/ios
/android

# Supabase CLI local link/session state
/supabase/.temp
/supabase/.branches
