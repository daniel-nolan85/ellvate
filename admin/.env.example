# The SAME Supabase project the mobile app (../) uses -- this dashboard reads
# and moderates that app's live data, it is not a separate database.

# Public: safe to embed in the client bundle. Used only for the magic-link
# sign-in flow (Supabase Auth), never for reading/writing moderated content.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret: server-only, NEVER prefixed with NEXT_PUBLIC_, never sent to the
# client. Bypasses Row Level Security by design -- this dashboard is the one
# place in the whole project that is allowed to read/act across every
# member's content instead of just its own. Get this from Supabase project
# settings -> API -> service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# Shared by both best-effort email features below (lib/hoa-email.ts and
# lib/account-removed-email.ts) -- same Resend account, different "from"
# identities. Optional -- leave unset and both features still work, they
# just no-op instead of sending, until there's a sending domain to send from.
# RESEND_API_KEY=

# Petitions: sent only when an admin explicitly clicks "Send to HOA board"
# on a succeeded petition -- never automatic.
# PETITIONS_FROM_EMAIL=
# HOA_NOTIFY_EMAIL=

# Account removal: sent automatically when an admin deletes a user from the
# Users page (see lib/account-removed-email.ts).
# ADMIN_FROM_EMAIL=

# Secret: server-only. Lets deleting a user also ban their Clerk identity
# (see lib/clerk.ts) so they can't just sign back in and get a fresh
# profile -- without this, Delete still removes their content but the
# account itself stays sign-in-able. Reuse the SAME value already set as
# CLERK_SECRET_KEY in the mobile app's EAS production environment. Get it
# from the Clerk dashboard -> API Keys -> Secret keys.
# CLERK_SECRET_KEY=
