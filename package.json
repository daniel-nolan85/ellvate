{
  "name": "expo-starter",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --dev-client",
    "start:lan": "expo start --dev-client --host lan --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "bun test tests/backend/*.test.ts tests/contracts/*.test.ts tests/platform/*.test.ts src/lib/*.test.ts src/modules/forum/*.test.ts src/modules/notifications/*.test.ts src/modules/missions/*.test.ts src/modules/authentication/sign-in/auth-errors.test.ts",
    "test:components": "jest --runInBand",
    "test:maestro": "maestro test maestro/flows/smoke/cold-launch.yaml",
    "test:maestro:disabled": "bash scripts/run-maestro.sh disabled maestro/flows/smoke/disabled-auth.yaml",
    "test:maestro:ui": "bash scripts/run-maestro.sh disabled maestro/flows/sections",
    "test:maestro:retry": "MAESTRO_PROFILE_SYNC_FAIL_ONCE=true bash scripts/run-maestro.sh disabled maestro/flows/onboarding/retry-profile-sync.yaml",
    "expo:doctor": "bunx expo-doctor",
    "expo:install:check": "bunx expo install --check",
    "export": "expo export --platform all",
    "check:architecture": "python3 scripts/check-saos-structure.py . --fail-on-warning",
    "check:production": "bun scripts/validate-production-env.ts",
    "test:supabase": "bun scripts/run-supabase-integration.ts",
    "db:link": "supabase link --project-ref xwtkfednponwvqafkeqj",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff --linked",
    "check": "bun run typecheck && bun run lint && bun run test && bun run check:architecture"
  },
  "dependencies": {
    "@clerk/backend": "3.11.0",
    "@clerk/expo": "3.2.15",
    "@expo-google-fonts/inter": "0.4.2",
    "@expo/html-elements": "^0.10.1",
    "@expo/vector-icons": "^15.0.3",
    "@gluestack-ui/core": "5.0.15",
    "@gluestack-ui/utils": "5.0.6",
    "@legendapp/motion": "^2.3.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@sentry/react-native": "8.21.0",
    "@supabase/supabase-js": "2.110.0",
    "@tanstack/query-async-storage-persister": "5.101.0",
    "@tanstack/react-query": "5.101.0",
    "@tanstack/react-query-persist-client": "5.101.0",
    "expo": "~54.0.36",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.19",
    "expo-web-browser": "~15.0.11",
    "lucide-react-native": "1.23.0",
    "nativewind": "^4.1.23",
    "react": "19.1.0",
    "react-aria": "^3.33.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.0",
    "react-native-safe-area-context": "^5.6.1",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "^0.5.1",
    "react-stately": "^3.39.0",
    "tailwind-variants": "^0.1.20"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.0.1",
    "@types/bun": "1.3.14",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.17",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "react-test-renderer": "19.1.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=20.19.0 <23"
  },
  "packageManager": "bun@1.3.13",
  "private": true
}
