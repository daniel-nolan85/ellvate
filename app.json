{
  "expo": {
    "name": "LLV Community",
    "slug": "llv-community-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/llv-logo.png",
    "scheme": "llv",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#171717",
        "foregroundImage": "./assets/images/llv-logo.png",
        "monochromeImage": "./assets/images/llv-logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/llv-splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#171717",
          "dark": {
            "backgroundColor": "#171717"
          }
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "cameraPermission": false,
          "microphonePermission": false,
          "photosPermission": "Let LLV Community access your photos so you can set a profile picture, add mission check-in photos, and upload service listing photos."
        }
      ],
      [
        "@clerk/expo",
        {
          "appleSignIn": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6366F1"
        }
      ],
      "@sentry/react-native/expo"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "autolinkingModuleResolution": true
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "enabled": false,
      "fallbackToCacheTimeout": 3000
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "15fc95df-574a-49ef-ab09-25c40e287987"
      }
    },
    "owner": "6missedcalls"
  }
}
