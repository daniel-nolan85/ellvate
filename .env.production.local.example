# Production-only overrides, applied on top of .env.local by
# `bun run deploy:backend` before exporting/deploying the backend.
# Copy this file to .env.production.local and fill in real values --
# .env.production.local itself is never committed (see .gitignore).
#
# Only list values that differ from local development here. This project's
# Clerk application has separate Development and Production instances (see
# docs/supabase-clerk.md), and .env.local intentionally holds the
# Development instance's keys for everyday local development -- both the
# secret key AND the publishable key differ between instances, so both need
# overriding here. Deploying straight from .env.local ships a backend (and,
# for the publishable key, a client bundle) that talks to the wrong Clerk
# instance and rejects every real (production) session token.

# The live keys from the Production instance's API Keys page in Clerk's
# dashboard (make sure the instance switcher is actually set to Production
# before copying these -- pk_live_.../sk_live_...).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Mission check-in face-detection (src/services/face-detection) defaults to
# reading its WASM binary and model weights straight off local disk
# (node_modules) -- fine for local dev and tests, but each app/api/**
# route deploys as its own independent bundled serverless function (see
# scripts/deploy-backend.ts), with no guarantee node_modules' binary assets
# survive that bundling. Setting these switches to fetching them over HTTPS
# instead, sidestepping that risk. jsDelivr's npm CDN serves any published
# package by exact version with no setup required:
# FACE_DETECTION_WASM_URL_PREFIX=https://cdn.jsdelivr.net/npm/@tensorflow/tfjs-backend-wasm@4.22.0/dist/
# FACE_DETECTION_MODEL_URL=https://cdn.jsdelivr.net/npm/@vladmandic/face-api@1.7.15/model
# Keep the version numbers in both URLs in sync with the exact (non-`^`)
# versions pinned for these two packages in package.json.
FACE_DETECTION_WASM_URL_PREFIX=
FACE_DETECTION_MODEL_URL=
