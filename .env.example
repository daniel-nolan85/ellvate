# Public values are embedded in the application bundle. Never put secrets here.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_AUTH_MODE=disabled
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Crash reporting (Sentry). Leave unset to run without crash reporting -- the
# app no-ops instead of failing when this isn't configured. Set it to start
# receiving crash/error reports; create a Sentry React Native project to get
# a DSN.
EXPO_PUBLIC_SENTRY_DSN=

# Neutral defaults work for local development. Customize these values for each
# copied app, and configure both native identifiers before making native builds.
# Mirror these non-public values in the matching EAS environment; EAS CLI does
# not use local dotenv files when resolving remote build and update jobs.
APP_NAME="Expo Starter"
APP_SLUG=expo-starter
APP_SCHEME=expo-starter
IOS_BUNDLE_IDENTIFIER=
ANDROID_PACKAGE=

# Stable, non-secret EAS project identifier returned when a copied app is linked.
# Set it locally and in each EAS environment to activate expo-updates config.
EAS_PROJECT_ID=

# Server-only secrets read by Expo API routes (app/api/**) via process.env.
# Never prefix these with EXPO_PUBLIC_ — they must not reach the client bundle.
# Use demo only for local disabled-auth development; deployed Clerk environments
# must set BACKEND_AUTH_MODE=clerk and provide a valid secret key.
BACKEND_AUTH_MODE=demo
# ANTHROPIC_API_KEY=
# CLERK_SECRET_KEY=

# Supabase. The API routes connect with the publishable key (safe/non-secret) and
# forward the caller's Clerk session token, so Row-Level Security enforces per-user
# access — no service-role/secret key is used. Register Clerk as a Supabase
# Third-Party Auth provider so the forwarded tokens are accepted (see docs/supabase-clerk.md).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Distributed assistant rate limiting. Required for Clerk/production mode;
# local demo and unit-test mode may use the explicit in-memory fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Live Supabase/RLS integration only. Inject short-lived Clerk session tokens
# at command runtime; never put these in dotenv files or CI artifacts.
# SUPABASE_TEST_USER_A_ID=
# SUPABASE_TEST_USER_A_TOKEN=
# SUPABASE_TEST_USER_B_ID=
# SUPABASE_TEST_USER_B_TOKEN=
