# The SAME Supabase project the mobile app (../) and admin dashboard
# (../admin) use. This site only ever inserts into `waitlist_signups` and
# `landing_contact_messages` through row-level-security policies scoped to
# those two tables -- it never needs the service-role key.

# Public: safe to embed in the client bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: forwards each waitlist signup / contact message by email on top
# of saving it to Supabase. Leave unset and everything still works -- rows
# just aren't also emailed anywhere -- until there's a domain to send from
# and an inbox to receive at.
#   RESEND_API_KEY      -- from resend.com, once you have an account
#   CONTACT_FROM_EMAIL  -- an address on a domain you've verified with Resend
#   CONTACT_NOTIFY_EMAIL -- where signups/messages should land
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_NOTIFY_EMAIL=

# Optional: the site's canonical URL, used for metadataBase, sitemap.ts, and
# robots.ts. Leave unset and it falls back to the Vercel-assigned
# preview/production URL -- only needs setting once a real domain is live
# (see lib/site-url.ts).
NEXT_PUBLIC_SITE_URL=
